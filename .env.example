# Public settings for the app, embedded at build time. None of these are secrets.
# Repo URL and contact email default to the values in src/lib/site.ts; set them only to override.
NEXT_PUBLIC_SITE_URL=https://tempochess.vercel.app
NEXT_PUBLIC_REPO_URL=https://github.com/danish-119/tempo-chess
NEXT_PUBLIC_CONTACT_EMAIL=mdanish.software.dev@gmail.com
NEXT_PUBLIC_WHATSAPP=923001877119

# The Tempo API (server/). Defaults to the local API on http://localhost:8787.
# On Vercel, set it to the deployed API. The host's security headers (vercel.json) always name the deployed API:
# PRODUCTION_API_URL in scripts/headers.mjs, or this value when it is an https address.
NEXT_PUBLIC_API_URL=http://localhost:8787

# The API's own settings live in server/wrangler.jsonc (vars) and server/.dev.vars (local secrets):
# see docs/DEPLOYMENT.md.
