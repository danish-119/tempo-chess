{
  "name": "tempo-chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-engine.mjs && node scripts/gen-headers.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/copy-engine.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "headers": "node scripts/gen-headers.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.3.0",
    "stockfish": "^19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Tempo \u2014 free, private chess game review powered by Stockfish.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.9"
  }
}
