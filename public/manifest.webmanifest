{
  "name": "Tempo — play, review and practise chess",
  "short_name": "Tempo",
  "description": "Play bots or a coach, review your games, solve puzzles and learn openings — free, private and fully offline. Stockfish runs in your browser.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#26282c",
  "theme_color": "#26282c",
  "categories": ["games", "education"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Play", "url": "/play", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Review a game", "url": "/review", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Puzzles", "url": "/practice?mode=puzzles", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
